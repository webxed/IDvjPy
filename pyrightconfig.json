{
  "include": ["src", "tests", "docker"],
  "executionEnvironments": [
    { "root": "tests", "extraPaths": ["src", "."] },
    { "root": "src" },
    { "root": "docker" },
    { "root": ".", "extraPaths": ["src"] }
  ],
  "typeCheckingMode": "basic",
  "exclude": ["build", "dist", "backups", "**/__pycache__"]
}
