# IDvjPy_term — что не попадает в git.
# Код и шаблоны — в репозитории; личные настройки, данные и сборки — нет.
# Самопроверка в рабочей копии: `git status --porcelain -uall` должен быть пустым.

# --- Личные данные приложения ---
# Шаблоны: src/settings.example.yml, src/llm_providers.example.yml, .bashrc_term.example
/settings.yml
llm_providers.yml
!src/llm_providers.example.yml
*.db
.bashrc_term
.bashrc_term_*
!.bashrc_term.example
!src/.bashrc_term.example
history*.txt
# :playbook — локальный сценарий демо (там же, где после :cd)
playbook.yml
# Дампы и экспорты: :export, JSON из блоков, снимки БД в backups/
*.json
!pyrightconfig.json
*.csv
backups/

# --- Корневой скретч: логи, demo_cmd.txt, test_ses.txt, test_*.yml и т.п. ---
# Исключения — файлы, которые специально лежат в репозитории.
/*.txt
!/requirements.txt
!/requirements-dev.txt
/test*.*
!/test_cmd.md

# --- Виртуальные окружения (в том числе созданные прямо в корне: bin/lib/include) ---
.venv/
venv/
pyvenv.cfg
/bin/
/lib/
# lib64 обычно симлинк на lib — без слэша, иначе шаблон не сработает
/lib64
/include/

# --- Сборка: setuptools (root setup.py), PyInstaller, packaging/build_wheel.sh ---
*.egg-info/
packaging/idvjpy_boot/src/
dist/
build/
*.spec

# --- Инструменты, кэш, редакторы ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.codegraph/
.DS_Store
*.swp
