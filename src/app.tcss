
/* Textual CSS (TCSS), а не браузерный CSS: `$surface`, `dock`, `layout`,
   `text-style` и т.п. — свойства Textual. Расширение `.tcss` выбрано специально:
   редакторы не линтуют такой файл браузерным CSS-парсером (иначе `property value
   expected` на каждой `$переменной`).
   Путь подключается через `CommandRunner.CSS_PATH`. */

Screen {
    layout: vertical;
}

Input {
    dock: top;
    height: 3;
    margin: 0 1;
    padding: 0 1;
    border: round #6b5494;
    background: $surface;
    overflow: hidden;
}

Input:focus {
    border: round #8a6bb5;
}

/* Строка ввода приложения: рамка — у контейнера, слева серым приглашение с cwd
   (`#cwd-prompt`: `~/проект ❯`), справа — само поле без своей рамки. Так путь
   виден всегда, пока строка пуста и пока в ней набирают команду (как в терминале),
   и не отнимает у поля высоту. Подсветка фокуса — у контейнера (`:focus-within`),
   иначе рамка не знала бы о фокусе вложенного поля. */
#input-row {
    dock: top;
    /* `100%`, а не `1fr`: у докнутого виджета Textual не вычитает margin из `1fr`,
       и строка уезжала бы за правый край. Тот же приём у `Input.DEFAULT_CSS`. */
    width: 100%;
    height: auto;
    margin: 0 1;
    padding: 0 1;
    border: round #6b5494;
    background: $surface;
}

#input-row:focus-within {
    border: round #8a6bb5;
}

#input-line {
    height: 1;
}

#cwd-prompt {
    width: auto;
    height: 1;
    color: $text-muted;
}

#command-input {
    dock: none;
    width: 1fr;
    height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
}

/* Превью длинной строки: поле однострочное и прокручивает значение под
   курсором — здесь видно всю команду, серым, с переносом по словам. */
#input-preview {
    display: none;
    height: auto;
    width: 100%;
    color: $text-muted;
}

CompletionList {
    margin: 0 1;
    border: round #4a8c58;
}

#results-container {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}

CommandBlock, InfoBlock {
    width: 100%;
    height: auto;
    padding: 0 1;
}

CommandBlock:focus, InfoBlock:focus, QueryResultsBlock:focus {
    /* Мягкая подсветка фокуса: 12% основного цвета темы поверх фона блока.
       Было `$primary-darken-1` — сплошная яркая заливка (замер отрисованного
       фона в textual-dark: прирост яркости 65 над фоном блока), затем 25% (~19),
       но и это читалось ярко — 12% даёт ~9: блок виден, текст не соревнуется
       с фоном. Смешение работает в любой теме. */
    background: $primary 12%;
}

CommandBlock.line-nav, InfoBlock.line-nav, QueryResultsBlock.line-nav {
    border-left: thick $accent;
}

/* Тема matrix (см. `MATRIX_THEME` в src/app.py): рамки в тон фосфору.
   У всех остальных тем остаются свои цвета выше (класс ставит watch_theme). */
Screen.matrix-mode Input {
    border: round $primary;
}

Screen.matrix-mode Input:focus {
    border: round $accent;
}

Screen.matrix-mode #input-row {
    border: round $primary;
}

Screen.matrix-mode #input-row:focus-within {
    border: round $accent;
}

Screen.matrix-mode CompletionList {
    border: round $secondary;
}

Screen.matrix-mode HandbookMarkdownScreen #md-frame {
    border: round $secondary;
}

/* Свернутый блок */
CommandBlock.collapsed {
    height: 1;
    overflow: hidden;
}

/* Стили для кликабельных ссылок на команды */
.link {
    text-style: bold;
    color: $accent;
    background: $primary-lighten-3;
}

.link:hover {
    background: $accent-lighten-2;
    text-style: bold;
}

/* Стили для JSON Viewer */
JSONViewer {
    layout: vertical;
    width: 100%;
    height: 100%;
}

JSONViewer #json-search {
    dock: top;
    height: 3;
}

JSONViewer Tree {
    width: 100%;
    height: 1fr;
    min-height: 8;
}

HandbookMarkdownScreen {
    layout: vertical;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: $background 80%;
}

HandbookMarkdownScreen #md-frame {
    width: 100%;
    height: 1fr;
    background: $surface;
    border: round #6b5494;
    padding: 0 1 1 1;
    overflow: hidden;
}

HandbookMarkdownScreen #md-title {
    height: 1;
    dock: top;
    margin-bottom: 1;
}

HandbookMarkdownScreen #md-scroll {
    height: 1fr;
    overflow-y: auto;
    overflow-x: auto;
}

DevopsScreensaver {
    layout: vertical;
    width: 100%;
    height: 100%;
    background: #000000;
    overflow: hidden;
}

DevopsScreensaver #ss-ticker {
    dock: top;
    height: 1;
    width: 100%;
    background: #000000;
    color: #00ff5f;
    overflow: hidden;
}

DevopsScreensaver #ss-ticker.-empty {
    height: 0;
    display: none;
}

DevopsScreensaver #ss-canvas {
    width: 100%;
    height: 1fr;
    background: #000000;
}
